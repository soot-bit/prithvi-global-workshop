import multiprocessing
import os
import subprocess
import sys

cpu_count = multiprocessing.cpu_count()
model_server_timeout = os.environ.get('MODEL_SERVER_TIMEOUT', '60')
model_server_workers = int(os.environ.get('MODEL_SERVER_WORKERS', cpu_count))
port = os.environ.get('PORT', '8080')  # Default port for GCP Cloud Run

def start_server():
    print(f'Starting the inference server on port {port} with {model_server_workers} workers.')

    # Start Gunicorn with UvicornWorker
    subprocess.check_call([
        'gunicorn',
        '--timeout', model_server_timeout,
        '-b', f'0.0.0.0:{port}',
        '-w', str(model_server_workers),
        '--worker-class', 'uvicorn.workers.UvicornWorker',
        'main:app'
    ])

if __name__ == '__main__':
    start_server()
